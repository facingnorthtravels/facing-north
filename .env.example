# =============================================================
# Facing North — Environment Variables
# Copy this file to .env.local for local dev, and set the same
# values in Vercel (Project → Settings → Environment Variables)
# for production. NEVER commit real keys.
# =============================================================

# ---- Site ----
# Your live domain (used for payment redirects, emails, PDF links).
# Local: http://localhost:3000  |  Prod: https://www.facingnorthtravels.com
NEXT_PUBLIC_SITE_URL=

# ---- Revolut Merchant (Payments) ----
# Secret API key from Revolut (Merchant → API → starts with "sk_")
REVOLUT_SECRET_KEY=
# Public key for the checkout widget (starts with "pk_")
NEXT_PUBLIC_REVOLUT_PUBLIC_KEY=
# Environment: "sandbox" for testing, "production" when going live
NEXT_PUBLIC_REVOLUT_ENV=sandbox
# Webhook signing secret (Revolut → Webhooks) — used to verify payment callbacks
REVOLUT_WEBHOOK_SECRET=

# ---- Resend (Booking confirmation & enquiry emails) ----
# API key from resend.com (starts with "re_")
RESEND_API_KEY=
# Inbox that receives booking notifications / enquiries
ADMIN_EMAIL=info@facingnorthtravels.com

# ---- Optional / Analytics ----
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=
INDEXNOW_KEY=
